apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: marching-worker-hpa

spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: marching-workers

  minReplicas: 1
  maxReplicas: 20

  metrics:
    - type: Resource
      resource:
        name: cpu

        target:
          type: Utilization
          averageUtilization: 70
